# Backend URL (set automatically by Vibecode)
EXPO_PUBLIC_BACKEND_URL=https://your-project.vibecode.run

# Crash reporting — optional, add Sentry DSN for production monitoring
# EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Google AdMob — production ad unit IDs (leave empty to use test IDs in dev)
# Get from: https://apps.admob.com
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-.../...
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-.../...
# EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-.../...
