PORT=3000
NODE_ENV=production

# Backend URL (used for auth config — set to your actual backend URL in production)
BACKEND_URL=https://your-backend-url.com

# Database URL — use file:./dev.db for SQLite in dev, or a PostgreSQL URL in production
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=file:./dev.db

# Email (Resend) — optional, enables password reset & welcome emails
RESEND_API_KEY=

# Admin setup protection — REQUIRED in production before calling /api/admin/setup
SETUP_SECRET=change-this-to-a-long-random-secret

# Logging level — debug | info | warn | error (default: "info" in production)
LOG_LEVEL=info

# Crash reporting — optional, connect Sentry for production error tracking
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
