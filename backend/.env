PORT=3000

# Database — SQLite for dev, PostgreSQL URL for production
DATABASE_URL="file:./dev.db"

# Email (Resend) — optional, used for password-reset emails
RESEND_API_KEY=

# Admin setup protection — set before calling /api/admin/setup in production
SETUP_SECRET=

# Logging — optional, defaults to "debug" in dev / "info" in prod
# LOG_LEVEL=info

# Crash reporting — optional, connect Sentry for production monitoring
# SENTRY_DSN=https://...@sentry.io/...
