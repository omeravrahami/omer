# Server Configuration
# Port the HTTP server listens on
PORT=3000
# Environment: development | production | test
NODE_ENV=development
# Public URL of this backend server (used for Better Auth and redirects)
BACKEND_URL=http://localhost:3000

# Database
# Dev/SQLite: file:./dev.db
# Production/PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=file:./dev.db

# Email (Resend — https://resend.com)
# Required to send transactional emails (e.g. password reset, verification)
RESEND_API_KEY=

# Admin Setup Protection
# Secret token required to call /api/admin/setup in production
# Leave empty in development, set a strong random value in production
SETUP_SECRET=dev-secret-change-in-production

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# Crash Reporting (Sentry — https://sentry.io)
# Optional. When set, unhandled errors are reported to Sentry.
# Get your DSN from: Sentry project → Settings → Client Keys (DSN)
SENTRY_DSN=

# CORS — Extra Allowed Origins
# Optional. Comma-separated list of additional origins to allow for CORS.
# Example: https://myapp.com,https://admin.myapp.com
# Default origins (localhost, vibecode domains) are always allowed.
ALLOWED_ORIGINS=
